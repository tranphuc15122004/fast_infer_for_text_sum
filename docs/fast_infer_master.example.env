# Fast Infer Text Sum — master config dùng chung cho mọi launcher.
#
# Copy file này ra ngoài repository, ví dụ:
#   /workspace/shared_storage/config/fast_infer_master.env
# Sau đó sửa các đường dẫn local/cache thực tế trên server B200.
# Repository chỉ giữ config/master.path trỏ tới file này.
# File được source bằng Bash; không dùng YAML/TOML và không cần internet.

# ---- runtime, offline/cache --------------------------------------------------
FI_PYTHON="${FI_PYTHON:-python3}"
FI_DEVICE="${FI_DEVICE:-cuda}"
FI_GPU_IDS="${FI_GPU_IDS:-0}"
FI_TARGET_GPU="${FI_TARGET_GPU:-B200}"
FI_OFFLINE="${FI_OFFLINE:-1}"
HF_TOKEN="${HF_TOKEN:-}"
FI_HF_HOME="${FI_HF_HOME:-$HOME/.cache/huggingface}"
FI_TRANSFORMERS_CACHE="${FI_TRANSFORMERS_CACHE:-$FI_HF_HOME/hub}"
FI_TRITON_CACHE="${FI_TRITON_CACHE:-$HOME/.cache/triton}"
FI_FLASHINFER_CACHE="${FI_FLASHINFER_CACHE:-$HOME/.cache/flashinfer}"
FI_TORCH_EXTENSIONS_CACHE="${FI_TORCH_EXTENSIONS_CACHE:-$HOME/.cache/torch_extensions}"

# ---- shared paths/models -----------------------------------------------------
MODEL_TARGET="${MODEL_TARGET:-/workspace/shared_storage/model/Llama3.1-8B-Instruct}"
MODEL_DFLASH_DRAFT="${MODEL_DFLASH_DRAFT:-/workspace/shared_storage/model/LLaMA3.1-8B-Instruct-DFlash-UltraChat}"
MODEL_EAGLE_DRAFT="${MODEL_EAGLE_DRAFT:-yuhuili/EAGLE3-LLaMA3.1-Instruct-8B}"
MODEL_SPEC_DRAFT="${MODEL_SPEC_DRAFT:-meta-llama/Llama-3.2-1B-Instruct}"
MODEL_COMPRESSOR="${MODEL_COMPRESSOR:-microsoft/llmlingua-2-xlm-roberta-large-meetingbank}"
MODEL_EMBEDDING="${MODEL_EMBEDDING:-sentence-transformers/all-MiniLM-L6-v2}"
MODEL_LONGSPEC_TARGET="${MODEL_LONGSPEC_TARGET:-lmsys/vicuna-7b-v1.5-16k}"
MODEL_LONGSPEC_DRAFT="${MODEL_LONGSPEC_DRAFT:-sail/longspec-vicuna-7b-v1.5-16k}"
MODEL_MAGICDEC_NAME="${MODEL_MAGICDEC_NAME:-TinyLlama/TinyLlama-1.1B-Chat-v1.0}"

# ---- canonical LongBench 9-baseline runner -------------------------------
LONG_BENCH_DATA_DIR="${LONG_BENCH_DATA_DIR:-data/longbench_200}"
LONG_BENCH_OUTPUT_DIR="${LONG_BENCH_OUTPUT_DIR:-outputs/longbench_200}"
LONG_BENCH_MODEL="${LONG_BENCH_MODEL:-$MODEL_TARGET}"
LONG_BENCH_BASELINES="${LONG_BENCH_BASELINES:-vanilla_hf vanilla_fa magicdec longspec eagle3 dflash specextend sssd fafo}"
LONG_BENCH_DATASETS="${LONG_BENCH_DATASETS:-gov_report qmsum multi_news lcc repobench-p}"
LONG_BENCH_MODE="${LONG_BENCH_MODE:-smoke}"
LONG_BENCH_SMOKE_SAMPLES="${LONG_BENCH_SMOKE_SAMPLES:-1}"
LONG_BENCH_REPRESENTATIVE_SAMPLES="${LONG_BENCH_REPRESENTATIVE_SAMPLES:-20}"
LONG_BENCH_FULL_SAMPLES="${LONG_BENCH_FULL_SAMPLES:-200}"
LONG_BENCH_REPRESENTATIVE_DATASETS="${LONG_BENCH_REPRESENTATIVE_DATASETS:-gov_report lcc}"
LONG_BENCH_MAX_NEW_TOKENS="${LONG_BENCH_MAX_NEW_TOKENS:-64}"
LONG_BENCH_SMOKE_MAX_NEW_TOKENS="${LONG_BENCH_SMOKE_MAX_NEW_TOKENS:-8}"
LONG_BENCH_TEMPERATURE="${LONG_BENCH_TEMPERATURE:-0}"
LONG_BENCH_WARMUP_RUNS="${LONG_BENCH_WARMUP_RUNS:-3}"
LONG_BENCH_SEED="${LONG_BENCH_SEED:-42}"
LONG_BENCH_MAX_INPUT_TOKENS="${LONG_BENCH_MAX_INPUT_TOKENS:-0}"
LONG_BENCH_LOCAL_FILES_ONLY="${LONG_BENCH_LOCAL_FILES_ONLY:-1}"
LONG_BENCH_TIMEOUT_SECONDS="${LONG_BENCH_TIMEOUT_SECONDS:-900}"
LONG_BENCH_STRICT="${LONG_BENCH_STRICT:-1}"
LONG_BENCH_EAGLE_MODEL="${LONG_BENCH_EAGLE_MODEL:-$MODEL_EAGLE_DRAFT}"
LONG_BENCH_DFLASH_MODEL="${LONG_BENCH_DFLASH_MODEL:-$MODEL_DFLASH_DRAFT}"
LONG_BENCH_LONGSPEC_TARGET_MODEL="${LONG_BENCH_LONGSPEC_TARGET_MODEL:-$MODEL_TARGET}"
LONG_BENCH_LONGSPEC_DRAFT_MODEL="${LONG_BENCH_LONGSPEC_DRAFT_MODEL:-$MODEL_LONGSPEC_DRAFT}"
LONG_BENCH_SPECEXTEND_DRAFT_MODEL="${LONG_BENCH_SPECEXTEND_DRAFT_MODEL:-$MODEL_EAGLE_DRAFT}"
LONG_BENCH_SSSD_DATASTORE_PATH="${LONG_BENCH_SSSD_DATASTORE_PATH:-${SSSD_DATASTORE_PATH:-}}"
LONG_BENCH_MAGICDEC_MODEL_PTH="${LONG_BENCH_MAGICDEC_MODEL_PTH:-$FI_HF_HOME/magicdec/llama-3.1-8b/model.pth}"
LONG_BENCH_MAGICDEC_MODEL_NAME="${LONG_BENCH_MAGICDEC_MODEL_NAME:-$MODEL_TARGET}"
LONG_BENCH_FAFO_KV_METHOD="${LONG_BENCH_FAFO_KV_METHOD:-${FAFO_KV_METHOD:-stream-llm}}"
CHECKPOINT_MAGICDEC="${CHECKPOINT_MAGICDEC:-$FI_HF_HOME/magicdec/tinyllama/model.pth}"
DATA_INPUT="${DATA_INPUT:-data/representative_100/xsum_representative.jsonl}"
SSSD_MODEL="${SSSD_MODEL:-$MODEL_TARGET}"
SSSD_DATA_FILE="${SSSD_DATA_FILE:-$DATA_INPUT}"
SSSD_DATASTORE_PATH="${SSSD_DATASTORE_PATH:-}"
SSSD_MAX_SAMPLES="${SSSD_MAX_SAMPLES:-1}"
SSSD_MAX_NEW_TOKENS="${SSSD_MAX_NEW_TOKENS:-32}"
SSSD_NUM_DRAFT_TOKENS="${SSSD_NUM_DRAFT_TOKENS:-8}"
SSSD_NUM_STEPS="${SSSD_NUM_STEPS:-5}"
SSSD_TOPK="${SSSD_TOPK:-5}"
SSSD_ADAPTIVE="${SSSD_ADAPTIVE:-0}"

FAFO_MODEL="${FAFO_MODEL:-$MODEL_TARGET}"
FAFO_DATA_FILE="${FAFO_DATA_FILE:-$DATA_INPUT}"
FAFO_MAX_SAMPLES="${FAFO_MAX_SAMPLES:-1}"
FAFO_MAX_NEW_TOKENS="${FAFO_MAX_NEW_TOKENS:-32}"
FAFO_KV_METHOD="${FAFO_KV_METHOD:-stream-llm}"
FAFO_USE_FLASH="${FAFO_USE_FLASH:-0}"
DATA_ROOT="${DATA_ROOT:-data}"
OUTPUT_ROOT="${OUTPUT_ROOT:-outputs}"

# Defaults chung cho chạy trực tiếp một baseline. BENCH_* bên dưới là profile
# riêng của representative_100 và được runner ưu tiên khi benchmark.
RUN_MODE="${RUN_MODE:-smoke}"
RUN_SAMPLES="${RUN_SAMPLES:-5}"
RUN_MAX_NEW_TOKENS="${RUN_MAX_NEW_TOKENS:-64}"
RUN_MAX_INPUT_TOKENS="${RUN_MAX_INPUT_TOKENS:-0}"
RUN_TEMPERATURE="${RUN_TEMPERATURE:-0}"
RUN_DOCUMENT_FIELD="${RUN_DOCUMENT_FIELD:-document}"
RUN_ID_FIELD="${RUN_ID_FIELD:-id}"
RUN_REFERENCE_FIELD="${RUN_REFERENCE_FIELD:-reference}"
RUN_SKIP_NAIVE="${RUN_SKIP_NAIVE:-0}"

# ---- DFlash ------------------------------------------------------------------
DFLASH_MODE="${DFLASH_MODE:-representative}"   # representative | gsm8k
DFLASH_BACKEND="${DFLASH_BACKEND:-transformers}"
DFLASH_DATASET="${DFLASH_DATASET:-gsm8k}"
DFLASH_DATA_FILE="${DFLASH_DATA_FILE:-$DATA_INPUT}"
DFLASH_MAX_SAMPLES="${DFLASH_MAX_SAMPLES:-5}"
DFLASH_MAX_NEW_TOKENS="${DFLASH_MAX_NEW_TOKENS:-64}"
DFLASH_SMOKE_SAMPLES="${DFLASH_SMOKE_SAMPLES:-1}"
DFLASH_SMOKE_NEW_TOKENS="${DFLASH_SMOKE_NEW_TOKENS:-128}"
DFLASH_TEMPERATURE="${DFLASH_TEMPERATURE:-0}"
DFLASH_BLOCK_SIZE="${DFLASH_BLOCK_SIZE:-}"
DFLASH_PROMPT="${DFLASH_PROMPT:-Summarize the following document.}"

# ---- EAGLE3 -----------------------------------------------------------------
EAGLE_BENCHMARK="${EAGLE_BENCHMARK:-qa}"
EAGLE_DATA_FILE="${EAGLE_DATA_FILE:-}"
EAGLE_QUESTION_BEGIN="${EAGLE_QUESTION_BEGIN:-0}"
EAGLE_QUESTION_END="${EAGLE_QUESTION_END:-10}"
EAGLE_MAX_NEW_TOKENS="${EAGLE_MAX_NEW_TOKENS:-64}"
EAGLE_NUM_CHOICES="${EAGLE_NUM_CHOICES:-1}"
EAGLE_TEMPERATURE="${EAGLE_TEMPERATURE:-0}"
EAGLE_TOTAL_TOKENS="${EAGLE_TOTAL_TOKENS:-32}"
EAGLE_DEPTH="${EAGLE_DEPTH:-8}"
EAGLE_TOP_K="${EAGLE_TOP_K:-4}"
EAGLE_SKIP_NAIVE="${EAGLE_SKIP_NAIVE:-0}"

# ---- LLMLingua / FastKV / GemFilter / FlexPrefill ---------------------------
LLMLINGUA_DATA_FILE="${LLMLINGUA_DATA_FILE:-$DATA_INPUT}"
LLMLINGUA_COMPRESSION_RATE="${LLMLINGUA_COMPRESSION_RATE:-0.5}"
LLMLINGUA_MAX_SAMPLES="${LLMLINGUA_MAX_SAMPLES:-3}"
LLMLINGUA_MAX_NEW_TOKENS="${LLMLINGUA_MAX_NEW_TOKENS:-64}"
LLMLINGUA_DEVICE="${LLMLINGUA_DEVICE:-$FI_DEVICE}"

FASTKV_METHOD="${FASTKV_METHOD:-fastkv}"
FASTKV_ATTN_IMPL="${FASTKV_ATTN_IMPL:-sdpa}"
FASTKV_MAX_NEW_TOKENS="${FASTKV_MAX_NEW_TOKENS:-64}"
FASTKV_WINDOW_SIZE="${FASTKV_WINDOW_SIZE:-1024}"
FASTKV_MAX_CAPACITY_PROMPTS="${FASTKV_MAX_CAPACITY_PROMPTS:-2048}"
FASTKV_RETAIN_RATE="${FASTKV_RETAIN_RATE:-0.1}"
FASTKV_EVICTION_MODE="${FASTKV_EVICTION_MODE:-proportional}"
FASTKV_NUM_RUNS="${FASTKV_NUM_RUNS:-2}"
FASTKV_DATA_ROOT="${FASTKV_DATA_ROOT:-$FI_HF_HOME/datasets/fast_infer_text_sum/FastKV/data}"

GEMFILTER_DATA_FILE="${GEMFILTER_DATA_FILE:-$DATA_INPUT}"
GEMFILTER_TOP_K="${GEMFILTER_TOP_K:-1024}"
GEMFILTER_SELECT_LAYER="${GEMFILTER_SELECT_LAYER:-13}"
GEMFILTER_PROMPT="${GEMFILTER_PROMPT:-The capital of France is}"
GEMFILTER_MAX_NEW_TOKENS="${GEMFILTER_MAX_NEW_TOKENS:-32}"
GEMFILTER_NUM_RUNS="${GEMFILTER_NUM_RUNS:-2}"

FLEXPREFILL_PATTERN="${FLEXPREFILL_PATTERN:-flex_prefill}"
FLEXPREFILL_DATA_FILE="${FLEXPREFILL_DATA_FILE:-$DATA_INPUT}"
FLEXPREFILL_MAX_SAMPLES="${FLEXPREFILL_MAX_SAMPLES:-5}"
FLEXPREFILL_MAX_NEW_TOKENS="${FLEXPREFILL_MAX_NEW_TOKENS:-64}"
FLEXPREFILL_SKIP_NAIVE="${FLEXPREFILL_SKIP_NAIVE:-0}"

# ---- SpecPrefill / MInference / Semantic Selection --------------------------
SPECPREFILL_CONFIG="${SPECPREFILL_CONFIG:-config_p1_full_lah8.yaml}"
SPECPREFILL_MAX_NEW_TOKENS="${SPECPREFILL_MAX_NEW_TOKENS:-64}"
SPECPREFILL_GPU_MEMORY_UTILIZATION="${SPECPREFILL_GPU_MEMORY_UTILIZATION:-0.8}"

MINFERENCE_ATTN_TYPE="${MINFERENCE_ATTN_TYPE:-minference}"
MINFERENCE_MAX_NEW_TOKENS="${MINFERENCE_MAX_NEW_TOKENS:-32}"
MINFERENCE_MAX_INPUT_TOKENS="${MINFERENCE_MAX_INPUT_TOKENS:-8192}"
MINFERENCE_DEVICE="${MINFERENCE_DEVICE:-$FI_DEVICE}"
MINFERENCE_ATTN_IMPLEMENTATION="${MINFERENCE_ATTN_IMPLEMENTATION:-auto}"

SEMANTIC_SELECTORS="${SEMANTIC_SELECTORS:-random lead tfidf textrank mmr}"
SEMANTIC_TOKEN_BUDGETS="${SEMANTIC_TOKEN_BUDGETS:-512 1024 2048}"
SEMANTIC_SMOKE_TOKEN_BUDGETS="${SEMANTIC_SMOKE_TOKEN_BUDGETS:-512}"
SEMANTIC_MAX_SAMPLES="${SEMANTIC_MAX_SAMPLES:-5}"
SEMANTIC_MAX_NEW_TOKENS="${SEMANTIC_MAX_NEW_TOKENS:-128}"
SEMANTIC_DEVICE="${SEMANTIC_DEVICE:-auto}"
SEMANTIC_DTYPE="${SEMANTIC_DTYPE:-auto}"
SEMANTIC_ATTN_IMPLEMENTATION="${SEMANTIC_ATTN_IMPLEMENTATION:-sdpa}"
SEMANTIC_WARMUP_ROUNDS="${SEMANTIC_WARMUP_ROUNDS:-0}"
SEMANTIC_EMBEDDING_DEVICE="${SEMANTIC_EMBEDDING_DEVICE:-cpu}"
SEMANTIC_RANDOM_SEED="${SEMANTIC_RANDOM_SEED:-42}"
SEMANTIC_MMR_LAMBDA="${SEMANTIC_MMR_LAMBDA:-0.7}"

# ---- HiGOE -------------------------------------------------------------------
HIGOE_RETRIEVER_MODEL="${HIGOE_RETRIEVER_MODEL:-facebook/contriever}"
HIGOE_NUM_DOCS="${HIGOE_NUM_DOCS:-3}"

# ---- SpecExtend / LongSpec / MagicDec ---------------------------------------
SPECEXTEND_SCRIPT="${SPECEXTEND_SCRIPT:-run_eagle.py}"
SPECEXTEND_MODEL_NAME="${SPECEXTEND_MODEL_NAME:-llama3_1_8b}"
SPECEXTEND_DATA_FILE="${SPECEXTEND_DATA_FILE:-data/govreport/govreport_512.jsonl}"
SPECEXTEND_MAX_SAMPLES="${SPECEXTEND_MAX_SAMPLES:-1}"
SPECEXTEND_MAX_NEW_TOKENS="${SPECEXTEND_MAX_NEW_TOKENS:-64}"
SPECEXTEND_MAX_INPUT_TOKENS="${SPECEXTEND_MAX_INPUT_TOKENS:-0}"
SPECEXTEND_ENABLED="${SPECEXTEND_ENABLED:-1}"
SPECEXTEND_WARMUP_RUNS="${SPECEXTEND_WARMUP_RUNS:-3}"

LONGSPEC_MODEL_NAME="${LONGSPEC_MODEL_NAME:-vicuna7b}"
LONGSPEC_METHOD="${LONGSPEC_METHOD:-tree}"
LONGSPEC_TASK="${LONGSPEC_TASK:-gov_report}"
LONGSPEC_MAX_NEW_TOKENS="${LONGSPEC_MAX_NEW_TOKENS:-1024}"
LONGSPEC_TREE_SHAPE="${LONGSPEC_TREE_SHAPE:-4 16 16 16 16}"
LONGSPEC_DATA_PREFIX="${LONGSPEC_DATA_PREFIX:-}"
LONGSPEC_DATA_FILE="${LONGSPEC_DATA_FILE:-}"
LONGSPEC_MAX_SAMPLES="${LONGSPEC_MAX_SAMPLES:-5}"

MAGICDEC_CACHE="${MAGICDEC_CACHE:-$FI_HF_HOME/magicdec}"
MAGICDEC_DATA_ROOT="${MAGICDEC_DATA_ROOT:-$DATA_ROOT}"
MAGICDEC_BATCH_SIZE="${MAGICDEC_BATCH_SIZE:-1}"
MAGICDEC_PREFIX_LEN="${MAGICDEC_PREFIX_LEN:-2048}"
MAGICDEC_MAX_INPUT_TOKENS="${MAGICDEC_MAX_INPUT_TOKENS:-2176}"
MAGICDEC_NUM_RUNS="${MAGICDEC_NUM_RUNS:-1}"
MAGICDEC_WINDOW_SIZE="${MAGICDEC_WINDOW_SIZE:-128}"
MAGICDEC_SELF_SPEC="${MAGICDEC_SELF_SPEC:-1}"
MAGICDEC_GAMMA="${MAGICDEC_GAMMA:-3}"
MAGICDEC_DRAFT_BUDGET="${MAGICDEC_DRAFT_BUDGET:-257}"
MAGICDEC_PREPARE_CHECKPOINT="${MAGICDEC_PREPARE_CHECKPOINT:-0}"
MAGICDEC_USE_TORCHRUN="${MAGICDEC_USE_TORCHRUN:-0}"
MAGICDEC_REPO_ID="${MAGICDEC_REPO_ID:-TinyLlama/TinyLlama-1.1B-Chat-v1.0}"
MAGICDEC_MODEL_KEY="${MAGICDEC_MODEL_KEY:-tinyllama}"

# ---- Qwen3 long profile ------------------------------------------------------
QWEN3_PROFILE_DATA_FILE="${QWEN3_PROFILE_DATA_FILE:-data/representative_100/govreport_representative.jsonl}"
QWEN3_PROFILE_WORD_MARKS="${QWEN3_PROFILE_WORD_MARKS:-256 512 1024 2048 3072}"
QWEN3_PROFILE_MAX_NEW_TOKENS="${QWEN3_PROFILE_MAX_NEW_TOKENS:-128}"
QWEN3_PROFILE_REPEATS="${QWEN3_PROFILE_REPEATS:-3}"
QWEN3_PROFILE_WARMUP_RUNS="${QWEN3_PROFILE_WARMUP_RUNS:-1}"
QWEN3_PROFILE_DEVICE="${QWEN3_PROFILE_DEVICE:-cuda:0}"
QWEN3_PROFILE_ATTN_IMPLEMENTATION="${QWEN3_PROFILE_ATTN_IMPLEMENTATION:-sdpa}"
QWEN3_PROFILE_LOCAL_FILES_ONLY="${QWEN3_PROFILE_LOCAL_FILES_ONLY:-1}"
QWEN3_PROFILE_OUTPUT_DIR="${QWEN3_PROFILE_OUTPUT_DIR:-src/analyze/full_infer/results}"

# ---- B200 smoke --------------------------------------------------------------
B200_MAX_SAMPLES="${B200_MAX_SAMPLES:-1}"
B200_MAX_NEW_TOKENS="${B200_MAX_NEW_TOKENS:-8}"
B200_MAX_INPUT_TOKENS="${B200_MAX_INPUT_TOKENS:-512}"
B200_TIMEOUT_SECONDS="${B200_TIMEOUT_SECONDS:-900}"
B200_OUTPUT_DIR="${B200_OUTPUT_DIR:-outputs/b200_smoke}"
B200_MAGICDEC_MODEL_PTH="${B200_MAGICDEC_MODEL_PTH:-$CHECKPOINT_MAGICDEC}"
B200_BASELINES="${B200_BASELINES:-eagle3 dflash llmlingua fastkv rocketkv gemfilter specprefill minference magicdec longspec specextend higoe semantic_selection flexprefill}"

# ---- representative_100 -----------------------------------------------------
BENCH_MODE="${BENCH_MODE:-full}"
BENCH_SAMPLES="${BENCH_SAMPLES:-}"
BENCH_NEW_TOKENS="${BENCH_NEW_TOKENS:-}"
BENCH_BASELINES="${BENCH_BASELINES:-}"
BENCH_DATASETS="${BENCH_DATASETS:-}"
BENCH_OUTPUT_DIR="${BENCH_OUTPUT_DIR:-outputs/representative_100}"
BENCH_TARGET_MODEL="${BENCH_TARGET_MODEL:-$MODEL_TARGET}"
BENCH_SPEC_MODEL="${BENCH_SPEC_MODEL:-$MODEL_SPEC_DRAFT}"
BENCH_EAGLE_MODEL="${BENCH_EAGLE_MODEL:-$MODEL_EAGLE_DRAFT}"
BENCH_DFLASH_MODEL="${BENCH_DFLASH_MODEL:-$MODEL_DFLASH_DRAFT}"
BENCH_COMPRESSOR_MODEL="${BENCH_COMPRESSOR_MODEL:-$MODEL_COMPRESSOR}"
BENCH_EMBEDDING_MODEL="${BENCH_EMBEDDING_MODEL:-$MODEL_EMBEDDING}"
BENCH_LONGSPEC_TARGET_MODEL="${BENCH_LONGSPEC_TARGET_MODEL:-$MODEL_LONGSPEC_TARGET}"
BENCH_LONGSPEC_DRAFT_MODEL="${BENCH_LONGSPEC_DRAFT_MODEL:-$MODEL_LONGSPEC_DRAFT}"
BENCH_SPECEXTEND_DRAFT_MODEL="${BENCH_SPECEXTEND_DRAFT_MODEL:-$BENCH_EAGLE_MODEL}"
BENCH_DFLASH_SMOKE_TARGET_MODEL="${BENCH_DFLASH_SMOKE_TARGET_MODEL:-Qwen/Qwen3-4B}"
BENCH_DFLASH_SMOKE_DRAFT_MODEL="${BENCH_DFLASH_SMOKE_DRAFT_MODEL:-z-lab/Qwen3-4B-DFlash-b16}"
BENCH_FLEXPREFILL_FULL_MODEL="${BENCH_FLEXPREFILL_FULL_MODEL:-$BENCH_TARGET_MODEL}"
BENCH_FLEXPREFILL_SMOKE_MODEL="${BENCH_FLEXPREFILL_SMOKE_MODEL:-Qwen/Qwen2.5-3B-Instruct}"
BENCH_MAX_INPUT_TOKENS="${BENCH_MAX_INPUT_TOKENS:-4096}"
BENCH_MINFERENCE_MAX_INPUT_TOKENS="${BENCH_MINFERENCE_MAX_INPUT_TOKENS:-3072}"
BENCH_DFLASH_MAX_INPUT_TOKENS="${BENCH_DFLASH_MAX_INPUT_TOKENS:-1024}"
BENCH_EAGLE_MAX_INPUT_TOKENS="${BENCH_EAGLE_MAX_INPUT_TOKENS:-1024}"
BENCH_SPECEXTEND_MAX_INPUT_TOKENS="${BENCH_SPECEXTEND_MAX_INPUT_TOKENS:-512}"
BENCH_FASTKV_ATTN_IMPL="${BENCH_FASTKV_ATTN_IMPL:-flash_attention_2}"
BENCH_T4_SMOKE_KERNEL_BASELINES="${BENCH_T4_SMOKE_KERNEL_BASELINES:-longspec}"
