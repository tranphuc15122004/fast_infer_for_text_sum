# SpecExtend + EAGLE-3 on Llama-3.1-8B-Instruct.
# Bundled summarization data: externals/SpecExtend/specextend/data/govreport/govreport_512.jsonl
SCRIPT="run_eagle.py"
MODEL_NAME="llama3_1_8b"
BASE_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"
DRAFT_MODEL="yuhuili/EAGLE3-LLaMA3.1-Instruct-8B"
INPUT_FILE="data/govreport/govreport_512.jsonl"
MAX_SAMPLES="1"
MAX_GEN_LEN="64"
MAX_INPUT_TOKENS="0"
USE_SPECEXTEND="1"

SMOKE="1"

OUTPUT_FILE="outputs/specextend_eagle_llama31.jsonl"
