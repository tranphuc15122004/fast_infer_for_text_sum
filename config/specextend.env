# SpecExtend verification config.
# Bundled summarization data: externals/SpecExtend/specextend/data/govreport/govreport_512.jsonl
# T4 smoke: vicuna-7b (13GB fp16) + 68M draft - marginal on 16GB; if OOM,
# reduce MAX_GEN_LEN or move to a bigger GPU for the full sweep.
SCRIPT="run_classic.py"
MODEL_NAME="vicuna_7b"
INPUT_FILE="data/govreport/govreport_512.jsonl"
MAX_SAMPLES="1"
MAX_GEN_LEN="64"
USE_SPECEXTEND="1"

SMOKE="1"

OUTPUT_FILE="outputs/specextend_smoke.jsonl"
