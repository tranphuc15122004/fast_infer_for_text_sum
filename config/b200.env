# Production profile for the B200 server.
#
# The server uses the Python 3.12 executable exposed as `python3`; it does not
# require activating a virtualenv. For local simulation only, invoke the
# runner with FAST_INFER_PYTHON="$PWD/.venv/bin/python".
FAST_INFER_PYTHON="${FAST_INFER_PYTHON:-python3}"
B200_TARGET_GPU="B200"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
B200_DEVICE="${B200_DEVICE:-cuda}"

# All JIT/compiler caches must be writable on the server. Override these paths
# for the actual shared scratch volume.
HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/hub}"
TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$HOME/.cache/triton}"
FLASHINFER_WORKSPACE_BASE="${FLASHINFER_WORKSPACE_BASE:-$HOME/.cache/flashinfer}"
TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-$HOME/.cache/torch_extensions}"

# Canonical large-GPU model matrix. Each value may be replaced by a local
# snapshot path on an offline server.
B200_TARGET_MODEL="${B200_TARGET_MODEL:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
B200_SPEC_MODEL="${B200_SPEC_MODEL:-meta-llama/Llama-3.2-1B-Instruct}"
B200_EAGLE_MODEL="${B200_EAGLE_MODEL:-yuhuili/EAGLE3-LLaMA3.1-Instruct-8B}"
B200_DFLASH_MODEL="${B200_DFLASH_MODEL:-z-lab/LLaMA3.1-8B-Instruct-DFlash-UltraChat}"
B200_COMPRESSOR_MODEL="${B200_COMPRESSOR_MODEL:-microsoft/llmlingua-2-xlm-roberta-large-meetingbank}"
B200_EMBEDDING_MODEL="${B200_EMBEDDING_MODEL:-sentence-transformers/all-MiniLM-L6-v2}"
B200_VICUNA_MODEL="${B200_VICUNA_MODEL:-lmsys/vicuna-7b-v1.5-16k}"
B200_LONGSPEC_DRAFT_MODEL="${B200_LONGSPEC_DRAFT_MODEL:-sail/longspec-vicuna-7b-v1.5-16k}"
B200_MAGICDEC_MODEL_PTH="${B200_MAGICDEC_MODEL_PTH:-$HOME/.cache/huggingface/magicdec/tinyllama/model.pth}"
B200_MAGICDEC_MODEL_NAME="${B200_MAGICDEC_MODEL_NAME:-TinyLlama/TinyLlama-1.1B-Chat-v1.0}"

B200_DATA_FILE="${B200_DATA_FILE:-data/representative_100/xsum_representative.jsonl}"
B200_SMOKE_MAX_SAMPLES="${B200_SMOKE_MAX_SAMPLES:-1}"
B200_SMOKE_MAX_NEW_TOKENS="${B200_SMOKE_MAX_NEW_TOKENS:-8}"
B200_TIMEOUT_SECONDS="${B200_TIMEOUT_SECONDS:-900}"

# Baseline list consumed by scripts/run_b200_smoke.sh.
B200_BASELINES="${B200_BASELINES:-eagle3 dflash llmlingua fastkv rocketkv gemfilter specprefill minference magicdec longspec specextend higoe semantic_selection flexprefill}"
