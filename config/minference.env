# MInference verification config.
# NOTE: model must be in MInference's support list (see minference.get_support_models()).
# On T4 16GB use the smallest supported model with a short context.
MODEL="Qwen/Qwen2.5-7B-Instruct"
ATTN_TYPE="minference"
MAX_NEW_TOKENS="32"
MAX_MODEL_LEN="8192"
DEVICE="cuda"

# Plug-and-play: drop your jsonl here and uncomment to generate over it.
# DATA_FILE="data/user_prompts.jsonl"
# MAX_SAMPLES="3"

SMOKE="1"

OUTPUT_FILE="outputs/minference_smoke.jsonl"
