# MagicDec verification config.
# T4 smoke: TinyLlama, B=1, short prefix. Convert checkpoint first:
#   PREPARE_CHECKPOINT=1 REPO_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0 \
#   MODEL_KEY=tinyllama bash scripts/run_magicdec.sh
MODEL_PTH="externals/MagicDec/checkpoints/tinyllama/model.pth"
MODEL_NAME="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
BATCH_SIZE="1"
PREFIX_LEN="2048"
MAX_LEN="2176"
NUM_RUNS="1"
WINDOW_SIZE="128"

# self-speculative decoding (no separate draft model)
SELF_SPEC="1"
GAMMA="3"
DRAFT_BUDGET="257"

PREPARE_CHECKPOINT="0"
# Single-GPU smoke runs directly in Python; set 1 only for distributed runs.
USE_TORCHRUN="0"
SMOKE="1"

OUTPUT_FILE="outputs/magicdec_smoke.jsonl"
