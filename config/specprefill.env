# speculative_prefill verification config (Llama family only).
# T4 smoke: small target + 1B draft to fit 16GB VRAM.
TARGET_MODEL="meta-llama/Llama-3.2-3B-Instruct"
SPEC_MODEL="meta-llama/Llama-3.2-1B-Instruct"
SPEC_CONFIG="config_p1_full_lah8.yaml"
MAX_TOKENS="64"
GPU_MEMORY_UTILIZATION="0.8"

# Plug-and-play: drop your jsonl here and uncomment to generate over it.
# DATA_FILE="data/user_prompts.jsonl"
# MAX_SAMPLES="3"

SMOKE="1"

OUTPUT_FILE="outputs/specprefill_smoke.jsonl"
