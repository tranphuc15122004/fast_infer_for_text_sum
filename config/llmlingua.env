# LLMLingua verification config.
# Compressor: LLMLingua-2 (XLM-RoBERTa encoder, lightweight, CPU-capable).
COMPRESSOR_MODEL="microsoft/llmlingua-2-xlm-roberta-large-meetingbank"

# Target LLM: use a locally cached Qwen2.5-1.5B-Instruct if present;
# can be overridden with a HF id or local snapshot path.
# TARGET_MODEL="/home/tuantb/.cache/huggingface/hub/models--Qwen--Qwen2.5-1.5B-Instruct/snapshots/..."

DOC_FILE="data/smoke_long_docs.jsonl"
COMPRESSION_RATE="0.5"
MAX_SAMPLES="3"
MAX_NEW_TOKENS="64"
DEVICE="cuda"

# Set to 1 for a fast run (2 samples, <=32 new tokens, CPU-friendly).
SMOKE="1"

OUTPUT_FILE="outputs/llmlingua_smoke.jsonl"
