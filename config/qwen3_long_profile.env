# Single-model Qwen3-4B long-summary profiler on a CUDA GPU.
# The default local snapshot avoids network access on the T4 server.
MODEL="/home/tuantb/.cache/huggingface/hub/models--Qwen--Qwen3-4B/snapshots/1cfa9a7208912126459214e8b04321603b3df60c"
INPUT_FILE="data/representative_100/govreport_representative.jsonl"
WORD_MARKS="256 512 1024 2048 3072"
MAX_NEW_TOKENS="128"
REPEATS="3"
WARMUP_RUNS="1"
DEVICE="cuda:0"
ATTN_IMPLEMENTATION="sdpa"
LOCAL_FILES_ONLY="1"
OUTPUT_DIR="src/analyze/full_infer/results"
