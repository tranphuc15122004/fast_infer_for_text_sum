# MagicDec checkpoint-prepare config: downloads TinyLlama HF checkpoint and
# converts it to model.pth for MagicDec's Transformer.from_name("tinyllama").
# Run: bash scripts/run.sh magicdec config/magicdec_prepare.env
# (then run the smoke with the default config/magicdec.env)
MODEL_PTH="checkpoints/tinyllama/model.pth"
MAGICDEC_DATA_ROOT="${MAGICDEC_DATA_ROOT:-${HF_HOME:-$HOME/.cache/huggingface}/datasets/fast_infer_text_sum/MagicDec/Data}"
MODEL_NAME="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
BATCH_SIZE="1"
PREFIX_LEN="2048"
MAX_LEN="2176"
NUM_RUNS="1"
SELF_SPEC="1"
GAMMA="3"
DRAFT_BUDGET="257"
PREPARE_CHECKPOINT="1"
REPO_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
MODEL_KEY="tinyllama"
SMOKE="1"
OUTPUT_FILE="outputs/magicdec_smoke.jsonl"
