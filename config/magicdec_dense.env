# MagicDec DENSE smoke config: validates the core engine (prefill + decode,
# flashinfer) on T4. Self-spec (draft cache) has a flashinfer 0.2.x positions
# incompatibility; run self-spec on the server with the repo's tested
# flashinfer version instead.
MODEL_PTH="externals/MagicDec/checkpoints/tinyllama/model.pth"
MODEL_NAME="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
BATCH_SIZE="1"
PREFIX_LEN="1024"
MAX_LEN="1152"
NUM_RUNS="1"
WINDOW_SIZE="128"
SELF_SPEC="0"
SMOKE="1"
OUTPUT_FILE="outputs/magicdec_smoke.jsonl"
