# GemFilter verification config.
# T4 smoke: Phi-3.5-mini (3.8B fp16 fits 16GB) with eager attention
# (GemFilter patches the eager attention class - no flash-attn needed).
MODEL="microsoft/Phi-3.5-mini-instruct"
TOPK="1024"
# selection layer: 13 (Llama-3.1-8B), 19 (Mistral-Nemo / Phi-3.5)
SELECT_LAYER_IDX="19"
PROMPT="The capital of France is"
MAX_GEN_LEN="32"
NUM_RUNS="2"

# Plug-and-play: drop your jsonl here and uncomment to generate over it.
# DATA_FILE="data/user_prompts.jsonl"
# MAX_SAMPLES="3"

SMOKE="1"

OUTPUT_FILE="outputs/gemfilter_smoke.jsonl"
