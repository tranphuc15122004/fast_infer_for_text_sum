# FastKV smoke config: T4-safe (snapkv + sdpa, TinyLlama).
# Uses a ~100-token doc so the SnapKV selection kernel actually engages:
#   max_capacity_prompt=64 > 0, window_size=32 <= prompt length.
# Full run: config/fastkv.env with a Mistral/Llama-7B model + long input.
MODEL="/home/tuantb/.cache/huggingface/hub/models--TinyLlama--TinyLlama-1.1B-Chat-v1.0/snapshots/fe8a4ea1ffedaf415f4da2f062534de366a451e6"
METHOD="fastkv"
EVICTION_MODE="constant"
WINDOW_SIZE="32"
MAX_CAPACITY_PROMPTS="64"
DATA_FILE="data/smoke_long_docs.jsonl"
MAX_SAMPLES="1"
MAX_NEW_TOKENS="16"
NUM_RUNS="1"
SMOKE="1"
OUTPUT_FILE="outputs/fastkv_smoke.jsonl"
