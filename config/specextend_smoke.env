# Smoke config for the paper's Llama-3.1-8B-Instruct + EAGLE-3 pair.
# It is intentionally short (one sample, 512 input tokens, 16 output tokens)
# but still loads the real target and EAGLE-3 checkpoint.
SCRIPT="run_eagle.py"
MODEL_NAME="llama3_1_8b"
BASE_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"
DRAFT_MODEL="yuhuili/EAGLE3-LLaMA3.1-Instruct-8B"
INPUT_FILE="data/govreport/govreport_512.jsonl"
MAX_SAMPLES="1"
MAX_GEN_LEN="16"
MAX_INPUT_TOKENS="512"
WARMUP_RUNS="0"
USE_SPECEXTEND="1"
SMOKE="1"
OUTPUT_FILE="outputs/specextend_smoke.jsonl"
