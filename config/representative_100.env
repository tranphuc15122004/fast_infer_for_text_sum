# Defaults cho scripts/run_representative_100.sh (benchmark trên data/representative_100).
# File này được source TRƯỚC khi parse CLI flags → CLI flags luôn thắng.
# Mọi biến để trống = dùng default của runner.

# smoke (T4-safe, 5 mẫu/baseline/dataset) | full (100 mẫu, model thật, GPU lớn)
# Server benchmark mặc định dùng full; truyền --mode smoke khi chỉ kiểm tra T4.
MODE="full"

# Số mẫu tối đa mỗi (baseline, dataset). Mặc định: smoke=5, full=100.
MAX_SAMPLES=""

# Override độ dài sinh (token). Để trống = giữ cấu hình riêng của từng baseline
# (llmlingua/fastkv/minference/eagle3: MAX_NEW_TOKENS; gemfilter/specextend:
# MAX_GEN_LEN; specprefill: MAX_TOKENS).
MAX_NEW_TOKENS=""

# Baseline cần chạy, cách nhau khoảng trắng. Để trống = toàn bộ baseline có
# adapter đọc representative: llmlingua fastkv gemfilter specprefill minference
# specextend eagle3 semantic_selection. Các baseline chưa có adapter không được
# chạy trá hình trong benchmark; dùng --include-unsupported chỉ để smoke probe.
BASELINES=""

# Dataset (tên file data/representative_100/<name>_representative.jsonl).
# Mặc định: tất cả (govreport multinews cnn_dailymail xsum).
DATASETS=""

# Nơi chứa outputs/logs/configs/data convert.
OUTPUT_DIR="outputs/representative_100"

# Canonical model matrix (M1-M9). Có thể ghi đè bằng --config ở server khác.
REP_TARGET_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"
REP_SPEC_MODEL="meta-llama/Llama-3.2-1B-Instruct"
REP_EAGLE_MODEL="yuhuili/EAGLE3-LLaMA3.1-Instruct-8B"
REP_DFLASH_MODEL="z-lab/LLaMA3.1-8B-Instruct-DFlash-UltraChat"
REP_COMPRESSOR_MODEL="microsoft/llmlingua-2-xlm-roberta-large-meetingbank"
REP_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
REP_VICUNA_MODEL="lmsys/vicuna-7b-v1.5-16k"
REP_SPECEXTEND_DRAFT_MODEL="double7/vicuna-68m"

# Full FastKV requires flash-attn on the target server. Override to sdpa only
# for a compatibility run; its throughput is not comparable to flash-attn.
FASTKV_FULL_ATTN_IMPL="flash_attention_2"
