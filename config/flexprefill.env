# FlexPrefill representative benchmark configuration.
# Runner override: full mode = Llama-3.1-8B-Instruct (REP_FLEXPREFILL_FULL_MODEL,
# cùng target canonical với các baseline khác); smoke (T4) = MODEL dưới đây
# (Qwen2.5-3B-Instruct, qwen2-arch, đã cache local, vừa 16GB).
MODEL="Qwen/Qwen2.5-3B-Instruct"
PATTERN="flex_prefill"
MAX_SAMPLES="5"
MAX_NEW_TOKENS="64"
DATA_FILE=""
SMOKE="1"
OUTPUT_FILE="outputs/flexprefill_smoke.jsonl"
