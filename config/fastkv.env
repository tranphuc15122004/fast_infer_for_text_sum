# FastKV verification config (Llama/Mistral only).
# T4 smoke: snapkv + sdpa (no flash-attn). Full: fastkv + flash_attention_2
# (requires `EXTRA_FLASH=1 scripts/setup_envs.sh` to build/install flash-attn).
MODEL="mistralai/Mistral-7B-Instruct-v0.3"
METHOD="fastkv"
ATTN_IMPL="sdpa"
MAX_NEW_TOKENS="64"
WINDOW_SIZE="1024"
MAX_CAPACITY_PROMPTS="2048"
RETAIN_RATE="0.1"
EVICTION_MODE="proportional"
NUM_RUNS="2"

# Plug-and-play: drop your jsonl here and uncomment to generate over it.
# DATA_FILE="data/user_prompts.jsonl"
# MAX_SAMPLES="3"

# T4-safe mode (overrides METHOD/ATTN_IMPL to snapkv/sdpa).
SMOKE="1"

OUTPUT_FILE="outputs/fastkv_smoke.jsonl"
