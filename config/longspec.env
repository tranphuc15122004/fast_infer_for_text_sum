# LongSpec verification config.
# Smoke (default): env import + triton TreeAttention dummy forward (T4-safe).
# Full (FULL=1, needs 80GB GPU): inference_long-bench.py on longbench data.
MODEL_NAME="llama8b"
METHOD="tree"
TASK="gov_report"
MAX_GEN_LEN="1024"
TREE_SHAPE="4 16 16 16 16"
# DATA_PATH_PREFIX="/path/to/preprocessed_longbench"  # required when FULL=1

SMOKE="1"
FULL="0"

OUTPUT_FILE="outputs/longspec_smoke.jsonl"
