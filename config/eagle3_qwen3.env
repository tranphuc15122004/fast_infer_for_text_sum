# Qwen3-4B base model already cached locally.
BASE_MODEL="/home/tuantb/.cache/huggingface/hub/models--Qwen--Qwen3-4B/snapshots/1cfa9a7208912126459214e8b04321603b3df60c"

# EAGLE3 drafter checkpoint downloaded from AngelSlim/Qwen3-4B_eagle3.
EAGLE_MODEL="/home/tuantb/models/Qwen3-4B_eagle3"

# The repository ships qa and sum question files. Full mode runs every
# question in [QUESTION_BEGIN, QUESTION_END) and reports
# tok/s, decoding speedup and mean acceptance length per question + a summary.
BENCH_NAME="qa"
QUESTION_BEGIN="0"
QUESTION_END="10"
MAX_NEW_TOKENS="64"
NUM_CHOICES="1"
TEMPERATURE="0"
SMOKE="1"

# Set to 1 to skip the naive autoregressive baseline (disables speedup stats,
# roughly halves the runtime).
# SKIP_NAIVE="0"

# EAGLE3 draft-tree settings matching the official EAGLE repo Qwen3 eval
# defaults (externals/EAGLE/eagle/evaluation/gen_ea_answer_qwen3.py):
#   --total-token 32  --depth 8  --top-k 4
# This is the paper's default dynamic draft tree for EAGLE3 on Qwen3 models.
TOTAL_TOKEN="32"
DEPTH="8"
TOP_K="4"

# Smoke overrides the range to exactly one question and caps generation.

OUTPUT_FILE="outputs/eagle3_qwen3_qa.jsonl"
